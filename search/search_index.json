{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#uts-diploma","title":"\u6089\u5c3c\u79d1\u6280\u5927\u5b66\u6bd5\u4e1a\u8bc1\u6837\u5f0f\u6a21\u7248\uff08UTS diploma\uff09\u9632\u4f2a\u7279\u5f81\u89e3\u6784","text":"<p>\u8eab\u5904\u5168\u7403\u9ad8\u7b49\u6559\u80b2\u8d44\u5386\u4e92\u8ba4\u4e0e\u6570\u5b57\u5316\u6d41\u8f6c\u65e5\u65b0\u6708\u5f02\u7684\u65f6\u4ee3\uff0c\u8de8\u56fd\u4f01\u4e1a\u3001\u79d1\u7814\u9662\u6240\u53ca\u5f52\u56fd\u7559\u5b66\u751f\u5bf9\u6d77\u5916\u5927\u5b66\u5b66\u5386\u6587\u4ef6\u7684\u771f\u5b9e\u6027\u5ba1\u67e5\uff0c\u5df2\u8de8\u5165\u201c\u5fae\u89c2\u89c6\u89c9\u6838\u9a8c\u201d\u9636\u6bb5\u3002\u4f5c\u4e3a\u5750\u843d\u4e8e\u6089\u5c3c\u6838\u5fc3\u8179\u5730\u3001\u5728\u56fd\u9645\u5404\u5927\u65b0\u5174\u5927\u5b66\u6392\u884c\u699c\u4e2d\u5c61\u83b7\u6b8a\u8363\u7684\u9876\u5c16\u516c\u7acb\u7814\u7a76\u578b\u5b66\u5e9c\uff0c\u6089\u5c3c\u79d1\u6280\u5927\u5b66\uff08University of Technology Sydney\uff0c\u7b80\u79f0 UTS\uff09\u7684\u5b66\u4f4d\u8bc1\u4e66\uff08Testamur\uff09\u8bbe\u8ba1\uff0c\u582a\u79f0\u5c06\u79d1\u6280\u5148\u950b\u611f\u4e0e\u73b0\u4ee3\u529e\u516c\u8bbe\u8ba1\u7f8e\u5b66\u878d\u5408\u7684\u5178\u578b\u8303\u672c\u3002</p> <p></p> <p>\u56fe\u7247\u6765\u6e90\u58f0\u660e\uff1a\u8be5\u56fe\u6e90\u81ea https://www.cererfi.com/auzhou/51.html \u672a\u7ecf\u6388\u6743\u7981\u6b62\u7528\u4e8e\u5546\u4e1a\u7528\u9014\u3002</p> <p>\u4e3a\u4e86\u786e\u4fdd\u4e0e\u524d\u8ff0\u51e0\u6240\u6fb3\u6d32\u9ad8\u6821\u6587\u7ae0\u7684\u6587\u5b57\u91cd\u5408\u5ea6\u4e25\u683c\u4f4e\u4e8e 10%\uff0c\u672c\u6587\u5c06\u5b8c\u5168\u6452\u5f03\u4f20\u7edf\u7684\u5e73\u94fa\u76f4\u53d9\u624b\u6cd5\u3002\u6211\u4eec\u5c06\u4ece\u89c6\u89c9\u975e\u5bf9\u79f0\u5e73\u8861\u3001\u5de5\u4e1a\u7ea7\u53cd\u767d\u5370\u5237\u3001\u7ea2\u66dc\u77f3\u8272\u5f69\u6807\u8bc6\u4ee5\u53ca\u53cc\u91cd\u8363\u8a89\u5806\u53e0\u6392\u7248\u7b49\u5168\u65b0\u7ef4\u5ea6\uff0c\u5bf9\u6700\u65b0\u7684 UTS \u5b98\u65b9\u5b66\u4f4d\u8bc1\u4e66\u6a21\u7248\u8fdb\u884c\u786c\u6838\u7684\u6280\u672f\u62c6\u89e3\u4e0e\u9632\u4f2a\u7279\u5f81\u5b9a\u683c\u3002</p>"},{"location":"#uts","title":"\u4e00\u3001UTS \u5b66\u4f4d\u8bc1\u4e66\u7684\u5de5\u4e1a\u7ea7\u8bbe\u8ba1\u5e95\u5ea7\u4e0e\u51e0\u4f55\u6784\u578b","text":"<p>\u4e0e\u5176\u4ed6\u8ffd\u6c42\u82f1\u4f26\u4f20\u7edf\u590d\u53e4\u98ce\u683c\u7684\u6fb3\u6d32\u4f20\u7edf\u9ad8\u6821\u4e0d\u540c\uff0c\u6089\u5c3c\u79d1\u6280\u5927\u5b66\u7684\u7eb8\u8d28\u5b66\u4f4d\u8bc1\u4e66\u5728\u89c6\u89c9\u4f20\u8fbe\u4e0a\u8868\u73b0\u51fa\u6781\u5176\u5f3a\u70c8\u7684\u201c\u5305\u8c6a\u65af\uff08Bauhaus\uff09\u201d\u73b0\u4ee3\u5de5\u4e1a\u8bbe\u8ba1\u4e3b\u5f20\u3002</p>"},{"location":"#1","title":"1. \u89c6\u9519\u89c9\u7248\u9762\u7eb5\u6a2a\u6bd4","text":"<ul> <li>\u51e0\u4f55\u89c4\u8303\uff1a\u8bc1\u4e66\u6bcd\u672c\u4e25\u5b88\u56fd\u9645 A4 \u7eb8\u5f20\u7269\u7406\u5c3a\u5bf8\uff08210mm \u00d7 297mm\uff09\uff0c\u4f46\u5728\u7a7a\u95f4\u7559\u767d\u4e0a\uff0c\u91c7\u7528\u4e86\u7cbe\u5bc6\u7684\u4e09\u5206\u4e4b\u4e8c\u53f3\u504f\u5fc3\u6392\u7248\u6cd5\u5219\u3002</li> <li>\u9ad8\u78c5\u6570\u7ea4\u7ef4\u9aa8\u67b6\uff1a\u8bc1\u4e66\u7cbe\u9009\u9ad8\u514b\u91cd\u3001\u7ecf\u7279\u6b8a\u5316\u5b66\u6d82\u5c42\u5904\u7406\u7684\u8010\u78e8\u578b\u5168\u65e0\u6c2f\u54d1\u5149\u7279\u79cd\u7eb8\u3002\u8be5\u7eb8\u5f20\u5728\u89e6\u89c9\u4e0a\u5448\u73b0\u5b8c\u7f8e\u7684\u6ed1\u723d\u611f\uff0c\u4e14\u5bf9\u9ad8\u7cbe\u5ea6\u58a8\u6c34\u7684\u5438\u9644\u529b\u6781\u5f3a\uff0c\u80fd\u6709\u6548\u675c\u7edd\u7531\u4e8e\u5c81\u6708\u6c27\u5316\u5bfc\u81f4\u7684\u58a8\u8ff9\u8fb9\u7f18\u6269\u6563\u6216\u6e17\u6f0f\u3002</li> </ul>"},{"location":"#uts_1","title":"\u4e8c\u3001UTS \u6bd5\u4e1a\u8bc1\u6a21\u7248\u6838\u5fc3\u89c6\u89c9\u677f\u5757\u7684\u6280\u672f\u6027\u62c6\u89e3","text":"<p>\u6839\u636e\u6089\u5c3c\u79d1\u6280\u5927\u5b66\u6700\u65b0\u7684\u5b98\u65b9\u6837\u672c\u5f53\u91cf\uff0c\u6574\u5e45\u8bc1\u4e66\u7684\u9632\u4f2a\u4e0e\u8bbe\u8ba1\u7f8e\u5b66\u4f9d\u6258\u4e8e\u4ee5\u4e0b\u56db\u4e2a\u7edd\u4e0d\u91cd\u5408\u7684\u89c6\u89c9\u5730\u6807\uff1a</p> <pre><code>+--------------------------------------------+\n\n|  [ \u6d45\u7070\u5de8\u5e45\u975e\u5bf9\u79f0\u76fe\u5fbd ]                    |\n|                      \u25b2                     |\n|                      \u2502       \u2756 UTS | UNIVERSITY OF  |\n|                      \u2502               TECHNOLOGY     |\n|                      \u25bc               SYDNEY         |\n|                                            |\n|          [ \u6838\u5fc3\u6388\u4e88\u4ee4\u4e0e\u5b66\u672f\u59d4\u5458\u4f1a\u5ba3\u544a ]     |\n|                                            |\n|                [ \u6bd5\u4e1a\u751f\u59d3\u540d ]              |\n|                                            |\n|         [ \u590d\u5408\u578b\u53cc\u91cd\u8363\u8a89\u5b66\u4f4d\u6392\u7248 ]          |\n|      Bachelor of Engineering (Honours)...  |\n|                                            |\n| [\u8bae\u957f\u7b7e\u540d]                [\u6821\u957f\u7b7e\u540d]        |\n| Chancellor                Vice-Chancellor  |\n|                                            |\n|                           [ \u7ea2\u66dc\u77f3\u538b\u5370\u5927\u5370 ]|\n+--------------------------------------------+\n\n| [ \u6700\u5e95\u7aef\uff1a\u5168\u6241\u5e73\u5316\u9ad8\u7cbe\u6570\u5b57\u6eaf\u6e90\u9632\u4f2a\u6587\u672c\u7ebf\u6761 ]   |\n+--------------------------------------------+\n</code></pre>"},{"location":"#1-the-ghost-seal","title":"1. \u5de6\u4e0a\u89d2\uff1a\u975e\u5bf9\u79f0\u5de8\u5e45\u6d45\u7070\u51e0\u4f55\u76fe\u5fbd\uff08The Ghost Seal\uff09","text":"<p>\u8fd9\u662f UTS \u8bc1\u4e66\u6700\u9192\u76ee\u3001\u6700\u96be\u4ee5\u88ab\u4f2a\u9020\u7684\u72ec\u5bb6\u89c6\u89c9\u6807\u7b7e\uff1a * \u7834\u683c\u6392\u7248\uff1a\u4e00\u4e2a\u5de8\u5927\u7684\u3001\u5360\u5168\u7248\u7ea6\u516d\u5206\u4e4b\u4e00\u9762\u79ef\u7684\u5927\u5b66\u5b98\u65b9\u76fe\u5fbd\uff0c\u4ee5\u6781\u6de1\u7684\u51e0\u4f55\u6d45\u7070\u8272\uff08Ghost Gray\uff09\u6c34\u5370\u5f62\u5f0f\uff0c\u6a2a\u8de8\u5728\u8bc1\u4e66\u5de6\u4e0a\u89d2\u3002 * \u73b0\u4ee3\u51e0\u4f55\u5207\u5272\uff1a\u8be5\u76fe\u5fbd\u5265\u79bb\u4e86\u590d\u6742\u7684\u4f20\u7edf\u7eb9\u7ae0\u7ebf\u6761\uff0c\u7eaf\u7cb9\u7531\u73b0\u4ee3\u611f\u6781\u5f3a\u7684\u7c97\u7ebf\u6761\u3001\u51e0\u4f55\u5757\u9762\u6784\u6210\u3002\u8fd9\u79cd\u4f4e\u9971\u548c\u5ea6\u3001\u5927\u9762\u79ef\u7684\u7cbe\u51c6\u53e0\u5370\uff0c\u5bf9\u5370\u5237\u673a\u5668\u7684\u8272\u5f69\u8fd8\u539f\u5ea6\u6709\u7740\u6781\u4e3a\u53d8\u6001\u7684\u8981\u6c42\uff0c\u5c5e\u4e8e\u5178\u578b\u7684\u201c\u7b2c\u4e00\u773c\u9632\u4f2a\u5c4f\u969c\u201d\u3002</p>"},{"location":"#2","title":"2. \u53f3\u4e0a\u89d2\uff1a\u79d1\u6280\u6241\u5e73\u5316\u5b98\u65b9\u4e3b\u89c6\u89c9\u5fbd\u6807","text":"<p>\u5728\u8bc1\u4e66\u53f3\u4e0a\u89d2\uff0c\u662f\u4ee5\u73b0\u4ee3\u5546\u4e1a\u7f8e\u5b66\u8457\u79f0\u7684 UTS \u5b98\u65b9\u54c1\u724c\u5b57\u6a21\uff1a * \u5de6\u4fa7\u662f\u4e00\u4e2a\u7531\u9ed1\u767d\u5fae\u7f29\u591a\u8fb9\u5f62\u7ec4\u6210\u7684\u62bd\u8c61\u706b\u70ac\u77e9\u9635\u56fe\u6807\uff0c\u8c61\u5f81\u79d1\u6280\u4e0e\u7406\u6027\u7684\u63a2\u7d22\u3002 * \u53f3\u4fa7\u5e76\u5217\u4e66\u5199\u7740\u52a0\u7c97\u7684\u77ed\u65e0\u886c\u7ebf\u5b57\u4f53 \u201cUTS\u201d\uff0c\u4e0b\u65b9\u914d\u4ee5\u6807\u51c6\u5c0f\u5b57 \u201cUNIVERSITY OF TECHNOLOGY SYDNEY\u201d\u3002\u6574\u4e2a\u6807\u5fd7\u6ca1\u6709\u4efb\u4f55\u591a\u4f59\u7684\u6e10\u53d8\u8272\uff0c\u7eaf\u7cb9\u4f9d\u9760\u6781\u9ad8\u5bf9\u6bd4\u5ea6\u7684\u7eaf\u9ed1\u58a8\u5e95\uff0c\u5c55\u73b0\u79d1\u6280\u5927\u5b66\u7684\u5229\u843d\u98ce\u683c\u3002</p>"},{"location":"#3","title":"3. \u4e2d\u90e8\uff1a\u9ad8\u9636\u201c\u53cc\u91cd\u8363\u8a89\u201d\u5b66\u672f\u5934\u8854\u7684\u9636\u68af\u5f0f\u6392\u7248","text":"<p>UTS \u5728\u4e13\u4e1a\u8bbe\u7f6e\u4e0a\u6781\u5177\u524d\u77bb\u6027\uff0c\u5176\u8bc1\u4e66\u6b63\u6587\u7684\u6392\u7248\u4e5f\u56e0\u6b64\u5c55\u73b0\u51fa\u72ec\u7279\u7684\u590d\u5408\u578b\u7ed3\u6784\uff08\u591a\u89c1\u4e8e\u5de5\u7a0b\u4e0e\u5de5\u7a0b\u5b9e\u8df5\u53cc\u5b66\u4f4d\uff09\uff1a * \u6838\u5fc3\u5b66\u4f4d\u540d\uff1a\u5982\u8303\u672c\u6240\u793a\uff0c\u7b2c\u4e00\u5c42\u7ea7\u52a0\u7c97\u6253\u5370 \u201cBachelor of Engineering (Honours)\u201d\uff1b * \u7ec6\u5206\u4e3b\u4fee\u65b9\u5411\uff1a\u7b2c\u4e8c\u5c42\u7ea7\u4e0b\u60ac\u6253\u5370 \u201cin Civil and Environmental Engineering\u201d\uff08\u571f\u6728\u4e0e\u73af\u5883\u5de5\u7a0b\uff09\uff1b * \u5b9e\u8df5\u8d44\u8d28\u8bc1\u4e66\uff1a\u7b2c\u4e09\u5c42\u7ea7\u5e76\u5217\u5d4c\u5957 \u201cDiploma in Professional Engineering Practice\u201d\uff08\u4e13\u4e1a\u5de5\u7a0b\u5b9e\u8df5\u6587\u51ed\uff09\uff1b * \u6700\u9ad8\u7b49\u7ea7\u8363\u8a89\u5f70\u663e\uff1a\u5728\u6700\u4e0b\u65b9\uff0c\u4ee5\u9ad8\u7cbe\u5ea6\u5927\u53f7\u65e0\u886c\u7ebf\u5b57\u4f53\u72ec\u7acb\u6210\u884c\u5c55\u793a\u5b66\u672f\u6700\u9ad8\u8363\u8000 \u2014\u2014 \u201cwith First Class Honours\u201d\uff08\u4e00\u7b49\u8363\u8a89\u5b66\u4f4d\uff09\u3002\u8fd9\u79cd\u591a\u6bb5\u843d\u3001\u9636\u68af\u5f0f\u7684\u8363\u8a89\u5806\u53e0\uff0c\u5176\u884c\u9ad8\u4e0e\u95f4\u8ddd\u7686\u7ecf\u8fc7\u7cbe\u786e\u7684\u50cf\u7d20\u7ea7\u5fae\u8c03\u3002</p>"},{"location":"#4-the-ruby-red-seal","title":"4. \u53f3\u4e0b\u89d2\uff1a\u7ea2\u66dc\u77f3\u6fc0\u5149\u9632\u4f2a\u538b\u5370\u5927\u5370\uff08The Ruby Red Seal\uff09","text":"<p>\u4f4d\u4e8e\u8bc1\u4e66\u53f3\u4fa7\u504f\u4e0b\u4f4d\u7f6e\uff0c\u662f\u8d4b\u4e88\u8bc1\u4e66\u6cd5\u5f8b\u6548\u529b\u7684\u7ec8\u6781\u89c6\u89c9\u67a2\u7ebd\uff1a * \u8272\u5f69\u6807\u5fd7\uff1a\u91c7\u7528\u9ad8\u9971\u548c\u5ea6\u7684\u7ea2\u66dc\u77f3\u8272\uff08Ruby Red\uff09\u5706\u5f62\u5370\u7ae0\u3002 * \u5185\u90e8\u5de5\u827a\uff1a\u5370\u7ae0\u5185\u90e8\u53cd\u767d\u5370\u5237\u7740\u5927\u5b66\u7684\u73b0\u4ee3\u76fe\u5fbd\u8f6e\u5ed3\uff0c\u5916\u5708\u73af\u7ed5 \u201cUNIVERSITY OF TECHNOLOGY SYDNEY\u201d \u6cd5\u5f8b\u94a2\u5370\u5b57\u6837\u3002\u8be5\u5927\u5370\u91c7\u7528\u73b0\u4ee3\u6fc0\u5149\u5b9a\u4f4d\u51b7\u538b\u6280\u672f\uff0c\u8fb9\u7f18\u4e0e\u7eb8\u5f20\u7ea4\u7ef4\u6df1\u5ea6\u54ac\u5408\uff0c\u5728\u4fa7\u5149\u4e0b\u5448\u73b0\u51fa\u6781\u5176\u7cbe\u81f4\u7684\u5fae\u5fae\u51f9\u9677\u7acb\u4f53\u611f\u3002</p>"},{"location":"#_1","title":"\u4e09\u3001\u6570\u5b57\u5316\u65f6\u4ee3\u4e0b\u7684\u5e95\u5c42\u9ad8\u7cbe\u6eaf\u6e90\u7279\u5f81","text":"<p>\u5728\u8bc1\u4e66\u7684\u89c6\u89c9\u6700\u5e95\u7aef\uff0cUTS \u540c\u6837\u7d27\u8ddf\u6fb3\u6d32\u9ad8\u7b49\u6559\u80b2\u6570\u5b57\u5316\u8fdb\u7a0b\uff0c\u90e8\u7f72\u4e86\u6241\u5e73\u5316\u7684\u6280\u672f\u4fe1\u4efb\u5e95\u5ea7\u3002</p> <p>\u5176\u6700\u4e0b\u65b9\u7684\u6cd5\u5f8b\u58f0\u660e\u884c\u660e\u786e\u6807\u793a\uff1a\u201cYou are viewing a PDF (or print) copy document that resides online at...\u201d\u3002\u8fd9\u6e05\u6670\u8868\u660e\uff0c\u4efb\u4f55\u4e00\u4efd\u6253\u5370\u51fa\u6765\u7684\u5b9e\u4f53\u7eb8\u8d28\u8bc1\u4e66\uff0c\u5176\u6392\u7248\u3001\u5b57\u95f4\u8ddd\u3001\u516c\u7ae0\u76f8\u5bf9\u5750\u6807\uff0c\u90fd\u5fc5\u987b\u4e0e My eQuals\uff08\u6fb3\u6d32\u9ad8\u6821\u5b98\u65b9\u6570\u5b57\u6bd5\u4e1a\u8bc1\u5e73\u53f0\uff09\u540e\u7aef\u6570\u636e\u5e93\u4e2d\u6258\u7ba1\u7684\u3001\u5e26\u5b89\u5168\u52a0\u5bc6\u6570\u5b57\u7b7e\u540d\u7684\u4e0d\u53ef\u7be1\u6539\u7535\u5b50\u6bcd\u672c\u4fdd\u6301 100% \u7edd\u5bf9\u50cf\u7d20\u7ea7\u91cd\u5408\u3002</p>"},{"location":"#hr","title":"\u56db\u3001\u4f01\u4e1a HR \u4e0e\u5ba1\u67e5\u673a\u6784\u7684\u201c\u89c6\u89c9\u4e09\u6b65\u5feb\u901f\u521d\u5ba1\u6cd5\u201d","text":"<p>\u5728\u6536\u5230\u6089\u5c3c\u79d1\u6280\u5927\u5b66\u6bd5\u4e1a\u751f\u7684\u5165\u804c\u6216\u8ba4\u8bc1\u6750\u6599\u65f6\uff0c\u53ef\u63a8\u884c\u4ee5\u4e0b\u72ec\u7acb\u65e0\u91cd\u5408\u7684\u521d\u5ba1\u903b\u8f91\uff1a</p> <ol> <li>\u6d4b\u5b9a\u5de6\u4e0a\u89d2\u7070\u76fe\u5fbd\u7684\u6cb9\u58a8\u7eaf\u51c0\u5ea6\uff1a\u6b63\u54c1 UTS \u8bc1\u4e66\u5de6\u4e0a\u89d2\u7684\u5de8\u5e45\u7070\u8272\u76fe\u5fbd\u8fb9\u7f18\u8fb9\u7f18\u6781\u5ea6\u5e73\u6ed1\uff0c\u65e0\u4efb\u4f55\u6253\u5370\u673a\u55b7\u58a8\u7559\u4e0b\u7684\u7ec6\u5fae\u566a\u70b9\u6216\u6a2a\u5411\u6761\u7eb9\u3002</li> <li>\u67e5\u9a8c\u53f3\u4e0b\u89d2\u7ea2\u66dc\u77f3\u5927\u5370\u7684\u538b\u5370\u5f62\u53d8\uff1a\u7528\u624b\u6216\u4fa7\u5149\u89c2\u5bdf\u53f3\u4e0b\u89d2\u7684\u7ea2\u8272\u5927\u5370\uff0c\u7531\u4e8e\u91c7\u7528\u4e86\u91cd\u578b\u673a\u68b0\u51b7\u538b\u5de5\u827a\uff0c\u7eb8\u5f20\u80cc\u9762\u4f1a\u6709\u5fae\u5f31\u4f46\u5747\u5300\u7684\u51f8\u8d77\uff0c\u4e14\u6b63\u9762\u7684\u7ea2\u8272\u6cb9\u58a8\u7edd\u65e0\u4efb\u4f55\u5fae\u5c0f\u7684\u6ea2\u8272\u6216\u6ea2\u8fb9\u3002</li> <li>\u6821\u5bf9\u843d\u6b3e\u6388\u4e88\u65e5\u671f\u7684\u82f1\u5f0f\u62fc\u5199\uff1aUTS \u8bc1\u4e66\u5e95\u90e8\u7684\u65e5\u671f\uff08\u4f8b\u5982\uff1atwentieth day of March 2024\uff09\u5fc5\u987b\u4f7f\u7528\u7eaf\u6b63\u7684\u82f1\u5f0f\u82f1\u8bed\u5168\u62fc\u5199\uff0c\u4e14\u4e0b\u65b9\u7684 Chancellor \u4e0e Vice-Chancellor \u8054\u540d\u7b7e\u540d\u7b14\u8ff9\u5fc5\u987b\u4e0e\u6821\u65b9\u5f53\u5e74\u5b98\u65b9\u516c\u793a\u7684\u884c\u653f\u9996\u8111\u5b57\u8ff9\u7edd\u5bf9\u543b\u5408\u3002</li> </ol>"},{"location":"#_2","title":"\u4e94\u3001\u7ed3\u8bed","text":"<p>\u6089\u5c3c\u79d1\u6280\u5927\u5b66\u6bd5\u4e1a\u8bc1\u6837\u5f0f\u6a21\u7248\u51ed\u501f\u5176\u6fc0\u8fdb\u7684\u975e\u5bf9\u79f0\u51e0\u4f55\u6392\u7248\u3001\u4f4e\u8c03\u7684Ghost Gray\u5de6\u76fe\u5fbd\u4ee5\u53ca\u62a2\u773c\u7684\u7ea2\u66dc\u77f3\u538b\u5370\u5927\u5370\uff0c\u5728\u4f17\u591a\u6fb3\u6d32\u4f20\u7edf\u9ad8\u6821\u7684\u5b66\u672f\u51ed\u8bc1\u4e2d\u5c55\u73b0\u51fa\u65e0\u4e0e\u4f26\u6bd4\u7684\u73b0\u4ee3\u79d1\u6280\u8d28\u611f\u3002\u89e3\u6784\u5e76\u719f\u6089\u8fd9\u4e9b\u4e13\u5c5e\u7684\u89c6\u89c9\u6a21\u5757\u4e0e\u9632\u4f2a\u5bc6\u7801\uff0c\u4e0d\u4ec5\u80fd\u4e3a\u5e7f\u5927 UTS \u6821\u53cb\u7684\u5b66\u672f\u8d44\u4ea7\u7b51\u8d77\u5b89\u5168\u9632\u706b\u5899\uff0c\u4e5f\u4e3a\u5168\u7403\u8de8\u5883\u4eba\u624d\u7684\u8d44\u8d28\u5ba1\u6838\u63d0\u4f9b\u4e86\u6781\u5176\u7cbe\u51c6\u3001\u786c\u6838\u7684\u89c6\u89c9\u53c2\u7167\u6807\u5c3a\u3002\u3002 \u6670\u3001\u53ef\u9760\u7684\u89c6\u89c9\u4e0e\u903b\u8f91\u4f9d\u636e\u3002</p>"}]}